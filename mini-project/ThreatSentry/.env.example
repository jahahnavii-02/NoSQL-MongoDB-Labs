APP_NAME=ThreatSentry AI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

MONGO_URI=mongodb://127.0.0.1:27133/
MONGO_DATABASE=threatsentry

CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=threatsentry

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=mxbai-embed-large

# --- added for the final model ---
SCANNER_MODE=wsl              # wsl (Windows + WSL2) | local (Linux host or Docker container)
WSL_DISTRIBUTION=Ubuntu
MITIGATION_DRY_RUN=true       # set false ONLY to really apply approved fixes
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=350
